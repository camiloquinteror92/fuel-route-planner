{
  "info": {
    "name": "Spotter Fuel Route API",
    "description": "Route + cheapest fuel stops inside the USA. Start the server with `python manage.py runserver` and run the requests in order. Run each request twice: the second run is served from the cache (see `meta.external_api_calls` and the `X-Response-Time-ms` header). Requests 1-4 make one call each to the public OSRM server the first time. Every /api/route response has a `Server-Timing` header with the time of each step (the Postman console of request 1 prints it), `summary.comparison` (the same trip for a price-blind driver) and `pipeline` (how the plan was computed). Requests 9 and 10 read the server's own counters and self-description.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "1. New York, NY -> Los Angeles, CA (long trip, many stops)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route?start=New York, NY&finish=Los Angeles, CA&start_tank=empty",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            },
            {
              "key": "start_tank",
              "value": "empty",
              "description": "empty (default) = pay for every mile; full = leave with a full tank",
              "disabled": true
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has fuel stops and a total cost', () => {",
              "  pm.expect(body.fuel_stops.length).to.be.above(0);",
              "  pm.expect(body.summary.total_fuel_cost).to.be.above(0);",
              "});",
              "pm.test('one routing call (0 when cached)', () => pm.expect(body.meta.external_api_calls).to.be.at.most(1));",
              "pm.test('every mile is paid (gallons = miles / 10)', () => {",
              "  pm.expect(body.summary.total_gallons_purchased).to.be.closeTo(body.route.distance_miles / 10, 0.1);",
              "});",
              "pm.test('stop costs add up to the total, to the cent', () => {",
              "  const sum = body.fuel_stops.reduce((acc, s) => acc + Math.round(s.cost * 100), 0);",
              "  pm.expect(sum).to.eql(Math.round(body.summary.total_fuel_cost * 100));",
              "});",
              "console.log('stops', body.summary.number_of_stops, 'cost $' + body.summary.total_fuel_cost, 'time', pm.response.headers.get('X-Response-Time-ms') + ' ms');",
              "console.log('map:', body.map.map_url);",
              "pm.test('Server-Timing breaks the time down', () => {",
              "  pm.expect(pm.response.headers.get('Server-Timing')).to.include('total;dur=');",
              "});",
              "console.log('external calls', body.meta.external_api_calls, (body.meta.external_api_services || []).join(',') || '-',",
              "  '| plan cache', body.meta.plan_cache, '| route cache', body.meta.route_cache);",
              "console.log('Server-Timing:', pm.response.headers.get('Server-Timing'));",
              "const blind = body.summary.comparison && body.summary.comparison.savings_vs_price_blind;",
              "if (blind) console.log('vs a price-blind driver: saves $' + blind.amount + ' (' + blind.percent + '%), stops +' + blind.extra_stops);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Chicago, IL -> Houston, TX (POST JSON)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Houston, TX\",\n  \"start_tank\": \"empty\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/route",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('every mile is paid (gallons = miles / 10)', () => {",
              "  pm.expect(body.summary.total_gallons_purchased).to.be.closeTo(body.route.distance_miles / 10, 0.1);",
              "});",
              "pm.test('stop costs add up to the total, to the cent', () => {",
              "  const sum = body.fuel_stops.reduce((acc, s) => acc + Math.round(s.cost * 100), 0);",
              "  pm.expect(sum).to.eql(Math.round(body.summary.total_fuel_cost * 100));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Los Angeles, CA -> New York, NY (first station at mile ~251: see warnings)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route?start=Los Angeles, CA&finish=New York, NY",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "Los Angeles, CA"
            },
            {
              "key": "finish",
              "value": "New York, NY"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('explains the start fuel in warnings', () => pm.expect(body.warnings.join(' ')).to.include('first station'));",
              "pm.test('every mile is paid (gallons = miles / 10)', () => {",
              "  pm.expect(body.summary.total_gallons_purchased).to.be.closeTo(body.route.distance_miles / 10, 0.1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Dallas, TX -> Austin, TX with a full tank (short trip, no stop)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route?start=Dallas, TX&finish=Austin, TX&start_tank=full",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "Dallas, TX"
            },
            {
              "key": "finish",
              "value": "Austin, TX"
            },
            {
              "key": "start_tank",
              "value": "full"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('no fuel stop needed', () => pm.expect(pm.response.json().fuel_stops).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Invalid: start outside the USA (Paris coordinates) -> 400",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route?start=48.8566,2.3522&finish=Austin, TX",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "48.8566,2.3522"
            },
            {
              "key": "finish",
              "value": "Austin, TX"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('explains the problem', () => pm.expect(body.detail.start[0]).to.include('USA'));",
              "pm.test('no external call', () => pm.expect(body.meta.external_api_calls).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Invalid: same place written two ways -> 400 same_location",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route?start=Austin, TX&finish=Austin, Texas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "Austin, TX"
            },
            {
              "key": "finish",
              "value": "Austin, Texas"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('same_location', () => pm.expect(pm.response.json().error).to.eql('same_location'));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Map page (HTML, served from the cache)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route/map?start=New York, NY&finish=Los Angeles, CA&start_tank=empty",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            "map"
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            },
            {
              "key": "start_tank",
              "value": "empty"
            }
          ]
        },
        "description": "Open the `map_url` from request 1 in a browser to see the Leaflet map. Postman shows the HTML."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Same trip with include=candidates (map layer, 0 calls after request 1)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route?start=New York, NY&finish=Los Angeles, CA&include=candidates",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            },
            {
              "key": "include",
              "value": "candidates",
              "description": "Adds every station within the corridor (price, mile marker, plan stop). It does not change the plan and shares its cache."
            }
          ]
        },
        "description": "The extra block the planner page draws as the corridor layer. After request 1 it is a plan cache hit: no external call."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('one row per corridor station', () => {",
              "  pm.expect(body.candidates.rows.length).to.eql(body.summary.candidate_stations_on_route);",
              "});",
              "pm.test('served from the plan cache of request 1 (0 calls)', () => {",
              "  pm.expect(body.meta.plan_cache).to.eql('hit');",
              "  pm.expect(body.meta.external_api_calls).to.eql(0);",
              "});",
              "console.log('Server-Timing:', pm.response.headers.get('Server-Timing'));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. GET /api/stats (requests, external calls, latency since start)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "stats"
          ]
        },
        "description": "Counters of this server process for /api/route: requests by status and outcome (cold, route cache, plan cache, error), external calls by service, latency percentiles. No locations are stored. Not rate limited, no external call."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const stats = pm.response.json();",
              "pm.test('counts the route requests', () => pm.expect(stats.route_requests.total).to.be.at.least(0));",
              "console.log('requests', JSON.stringify(stats.route_requests.by_outcome));",
              "console.log('OSRM calls per routing request', stats.external_api.osrm_calls_per_routing_request);",
              "console.log('latency', JSON.stringify(stats.latency_ms));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. GET /api/about (versions, data, requirements, tests, errors)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/about",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "about"
          ]
        },
        "description": "What the server runs (Python, Django, commit), the loaded station data, each requirement of the assessment with the code and tests that show it, the last local pytest run and the error catalog. The planner page embeds this document."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const about = pm.response.json();",
              "pm.test('reports the running Django', () => pm.expect(about.versions.django).to.be.a('string'));",
              "pm.test('maps every requirement to code and tests', () => pm.expect(about.requirements.length).to.be.above(0));",
              "console.log('Django', about.versions.django, '| commit', about.build.commit_short, '| stations', about.data.stations);",
              "console.log('last pytest run', JSON.stringify(about.tests));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Invalid: a city in Canada (Toronto, ON) -> 400 location_outside_usa, no call",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route?start=Toronto, ON&finish=Austin, TX",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "Toronto, ON"
            },
            {
              "key": "finish",
              "value": "Austin, TX"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "const body = pm.response.json();",
              "pm.test('location_outside_usa', () => pm.expect(body.error).to.eql('location_outside_usa'));",
              "pm.test('says which field', () => pm.expect(body.field).to.eql('start'));",
              "pm.test('no external call (not even a geocoding one)', () => pm.expect(body.meta.external_api_calls).to.eql(0));"
            ]
          }
        }
      ]
    }
  ]
}
