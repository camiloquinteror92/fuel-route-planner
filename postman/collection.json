{
 "info": {
  "name": "Spotter Fuel Route API",
  "description": "A truck trip inside the USA: the route, the cheapest places to buy fuel and the total cost. Start the server with `python manage.py runserver` and send the requests in order: they follow the demo video. Request 1 makes one request to OSRM, the free routing service; send it twice and the second time it makes none (`meta.external_api_calls`). Requests 5, 6 and 11 change the truck on the same trip, so they make none either. Requests 7 to 11 show the errors.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://127.0.0.1:8000"
  }
 ],
 "item": [
  {
   "name": "1. New York, NY → Los Angeles, CA",
   "request": {
    "method": "GET",
    "url": {
     "raw": "{{baseUrl}}/api/route?start=New York, NY&finish=Los Angeles, CA&start_tank=empty",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "route"
     ],
     "query": [
      {
       "key": "start",
       "value": "New York, NY"
      },
      {
       "key": "finish",
       "value": "Los Angeles, CA"
      },
      {
       "key": "start_tank",
       "value": "empty",
       "description": "empty (default) = pay for every mile; full = leave with a free full tank"
      }
     ]
    },
    "description": "A long trip, about 2,800 miles, so the truck stops several times. Look at `fuel_stops` (each `decision` says which rule chose the stop), `summary.total_fuel_cost` and `meta.external_api_calls`: 1 the first time (the road comes from OSRM), 0 when you send it again. Copy `map.map_url` and open it in a browser to see the same plan on the map page."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const body = pm.response.json();",
       "pm.test('has fuel stops and a total cost', () => {",
       "  pm.expect(body.fuel_stops.length).to.be.above(0);",
       "  pm.expect(body.summary.total_fuel_cost).to.be.above(0);",
       "});",
       "pm.test('every stop says which rule chose it', () => {",
       "  body.fuel_stops.forEach((s) => pm.expect(['reach_cheaper', 'finish', 'fill_up']).to.include(s.decision.rule));",
       "});",
       "pm.test('at most one request to OSRM (0 when sent again)', () => pm.expect(body.meta.external_api_calls).to.be.at.most(1));",
       "pm.test('the stop costs add up to the total, to the cent', () => {",
       "  const cents = body.fuel_stops.reduce((sum, s) => sum + Math.round(s.cost * 100), 0);",
       "  pm.expect(cents).to.eql(Math.round(body.summary.total_fuel_cost * 100));",
       "});",
       "pm.test('Server-Timing breaks the time down', () => pm.expect(pm.response.headers.get('Server-Timing')).to.include('total;dur='));",
       "console.log('stops', body.summary.number_of_stops, '| cost $' + body.summary.total_fuel_cost,",
       "  '| gallons', body.summary.total_gallons_purchased, '| calls to OSRM', body.meta.external_api_calls,",
       "  '| time', pm.response.headers.get('X-Response-Time-ms') + ' ms');",
       "console.log('map:', body.map.map_url);"
      ]
     }
    }
   ]
  },
  {
   "name": "2. Chicago, IL → Houston, TX (POST JSON)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "body": {
     "mode": "raw",
     "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Houston, TX\"\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    },
    "url": {
     "raw": "{{baseUrl}}/api/route",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "route"
     ]
    },
    "description": "The same endpoint with a JSON body. A new trip: 1 request to OSRM the first time."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const body = pm.response.json();",
       "pm.test('the stop costs add up to the total, to the cent', () => {",
       "  const cents = body.fuel_stops.reduce((sum, s) => sum + Math.round(s.cost * 100), 0);",
       "  pm.expect(cents).to.eql(Math.round(body.summary.total_fuel_cost * 100));",
       "});",
       "pm.test('at most one request to OSRM', () => pm.expect(body.meta.external_api_calls).to.be.at.most(1));",
       "console.log('stops', body.summary.number_of_stops, '| cost $' + body.summary.total_fuel_cost,",
       "  '| gallons', body.summary.total_gallons_purchased, '| calls to OSRM', body.meta.external_api_calls,",
       "  '| time', pm.response.headers.get('X-Response-Time-ms') + ' ms');"
      ]
     }
    }
   ]
  },
  {
   "name": "3. Dallas, TX → Austin, TX with a full tank (start_tank=full)",
   "request": {
    "method": "GET",
    "url": {
     "raw": "{{baseUrl}}/api/route?start=Dallas, TX&finish=Austin, TX&start_tank=full",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "route"
     ],
     "query": [
      {
       "key": "start",
       "value": "Dallas, TX"
      },
      {
       "key": "finish",
       "value": "Austin, TX"
      },
      {
       "key": "start_tank",
       "value": "full"
      }
     ]
    },
    "description": "A short trip that leaves with a full tank. The tank covers the whole trip, so there is no stop and nothing to pay: only fuel bought on the way is counted."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const body = pm.response.json();",
       "pm.test('no stop and nothing to pay', () => {",
       "  pm.expect(body.fuel_stops.length).to.eql(0);",
       "  pm.expect(body.summary.total_fuel_cost).to.eql(0);",
       "});",
       "pm.test('the tank mode is full', () => pm.expect(body.vehicle.start_tank).to.eql('full'));",
       "console.log('stops', body.summary.number_of_stops, '| cost $' + body.summary.total_fuel_cost,",
       "  '| gallons', body.summary.total_gallons_purchased, '| calls to OSRM', body.meta.external_api_calls,",
       "  '| time', pm.response.headers.get('X-Response-Time-ms') + ' ms');"
      ]
     }
    }
   ]
  },
  {
   "name": "4. Map page (HTML) of request 1, 0 calls",
   "request": {
    "method": "GET",
    "url": {
     "raw": "{{baseUrl}}/api/route/map?start=New York, NY&finish=Los Angeles, CA&start_tank=empty",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "route",
      "map"
     ],
     "query": [
      {
       "key": "start",
       "value": "New York, NY"
      },
      {
       "key": "finish",
       "value": "Los Angeles, CA"
      },
      {
       "key": "start_tank",
       "value": "empty"
      }
     ]
    },
    "description": "The `map.map_url` of request 1. Postman shows the HTML; open it in a browser to see the guided page. The page itself never plans: its JavaScript sends request 1 again, which is answered from memory with no request to OSRM."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "pm.test('an HTML page', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
      ]
     }
    }
   ]
  },
  {
   "name": "5. What-if: a thirstier truck (mpg=8&max_range_miles=400), 0 calls",
   "request": {
    "method": "GET",
    "url": {
     "raw": "{{baseUrl}}/api/route?start=New York, NY&finish=Los Angeles, CA&mpg=8&max_range_miles=400",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "route"
     ],
     "query": [
      {
       "key": "start",
       "value": "New York, NY"
      },
      {
       "key": "finish",
       "value": "Los Angeles, CA"
      },
      {
       "key": "mpg",
       "value": "8",
       "description": "Miles per gallon, 3 to 30 (default 10)."
      },
      {
       "key": "max_range_miles",
       "value": "400",
       "description": "Miles on a full tank, 100 to 1500 (default 500). 400 / 8 = the same 50-gallon tank."
      }
     ]
    },
    "description": "The trip of request 1 with a truck that does 8 miles per gallon and keeps the same 50-gallon tank (400 miles on a full tank). Only the plan changes, not the road, so there is no request to OSRM. `meta.settings_changed` names what differs from the standard truck."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const body = pm.response.json();",
       "pm.test('no request to OSRM: the road of request 1 is reused', () => {",
       "  pm.expect(body.meta.external_api_calls).to.eql(0);",
       "  pm.expect(body.meta.route_cache).to.eql('hit');",
       "});",
       "pm.test('mpg and range are the changed settings', () => {",
       "  pm.expect(body.meta.settings_changed).to.include.members(['mpg', 'max_range_miles']);",
       "});",
       "pm.test('same 50-gallon tank', () => pm.expect(body.vehicle.tank_gallons).to.eql(50));",
       "console.log('stops', body.summary.number_of_stops, '| cost $' + body.summary.total_fuel_cost,",
       "  '| gallons', body.summary.total_gallons_purchased, '| calls to OSRM', body.meta.external_api_calls,",
       "  '| time', pm.response.headers.get('X-Response-Time-ms') + ' ms');"
      ]
     }
    }
   ]
  },
  {
   "name": "6. What-if: keep 5 gallons of safety fuel (POST, safety_reserve_gal=5)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "body": {
     "mode": "raw",
     "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\",\n  \"safety_reserve_gal\": 5\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    },
    "url": {
     "raw": "{{baseUrl}}/api/route",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "route"
     ]
    },
    "description": "The trip of request 1, but the truck must keep 5 gallons in the tank at every stop and at the finish. With no safety fuel (the default) it may reach a station on empty. No request to OSRM."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const body = pm.response.json();",
       "pm.test('no request to OSRM: the road of request 1 is reused', () => {",
       "  pm.expect(body.meta.external_api_calls).to.eql(0);",
       "  pm.expect(body.meta.route_cache).to.eql('hit');",
       "});",
       "pm.test('never below 5 gallons', () => {",
       "  body.fuel_stops.forEach((s) => pm.expect(s.fuel_on_arrival_gallons).to.be.at.least(5));",
       "  pm.expect(body.summary.end_fuel_gallons).to.be.at.least(5);",
       "});",
       "console.log('stops', body.summary.number_of_stops, '| cost $' + body.summary.total_fuel_cost,",
       "  '| gallons', body.summary.total_gallons_purchased, '| calls to OSRM', body.meta.external_api_calls,",
       "  '| time', pm.response.headers.get('X-Response-Time-ms') + ' ms');"
      ]
     }
    }
   ]
  },
