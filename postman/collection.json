{
  "info": {
    "name": "Spotter Fuel Route API",
    "description": "Route + cheapest fuel stops inside the USA. Start the server with `python manage.py runserver` and run the requests in order. Run each request twice: the second run is served from the cache (see `meta.external_api_calls` and the `X-Response-Time-ms` header). Requests 1-4 make one call each to the public OSRM server the first time. Every /api/route response has a `Server-Timing` header with the time of each step (the Postman console of request 1 prints it), `summary.comparison` (the same trip for a price-blind driver) and `pipeline` (how the plan was computed). Requests 9 and 10 read the server's own counters and self-description. Requests 12-18 are what-if questions on the trip of request 1: each changes one setting (mpg, range, corridor, price policy, consolidation, safety reserve), re-plans on the cached route with 0 external calls and lists the changed settings in `meta.settings_changed`. Requests 19-20 are the type-ahead of places (offline). Requests 21-22 list the tests and run the whole suite (only when the server runs on your own machine; anywhere else the run answers 403).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "1. New York, NY -> Los Angeles, CA (long trip, many stops)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route?start=New York, NY&finish=Los Angeles, CA&start_tank=empty",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            },
            {
              "key": "start_tank",
              "value": "empty",
              "description": "empty (default) = pay for every mile; full = leave with a full tank",
              "disabled": true
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has fuel stops and a total cost', () => {",
              "  pm.expect(body.fuel_stops.length).to.be.above(0);",
              "  pm.expect(body.summary.total_fuel_cost).to.be.above(0);",
              "});",
              "pm.test('one routing call (0 when cached)', () => pm.expect(body.meta.external_api_calls).to.be.at.most(1));",
              "pm.test('every mile is paid (gallons = miles / 10)', () => {",
              "  pm.expect(body.summary.total_gallons_purchased).to.be.closeTo(body.route.distance_miles / 10, 0.1);",
              "});",
              "pm.test('stop costs add up to the total, to the cent', () => {",
              "  const sum = body.fuel_stops.reduce((acc, s) => acc + Math.round(s.cost * 100), 0);",
              "  pm.expect(sum).to.eql(Math.round(body.summary.total_fuel_cost * 100));",
              "});",
              "console.log('stops', body.summary.number_of_stops, 'cost $' + body.summary.total_fuel_cost, 'time', pm.response.headers.get('X-Response-Time-ms') + ' ms');",
              "console.log('map:', body.map.map_url);",
              "pm.test('Server-Timing breaks the time down', () => {",
              "  pm.expect(pm.response.headers.get('Server-Timing')).to.include('total;dur=');",
              "});",
              "console.log('external calls', body.meta.external_api_calls, (body.meta.external_api_services || []).join(',') || '-',",
              "  '| plan cache', body.meta.plan_cache, '| route cache', body.meta.route_cache);",
              "console.log('Server-Timing:', pm.response.headers.get('Server-Timing'));",
              "const blind = body.summary.comparison && body.summary.comparison.savings_vs_price_blind;",
              "if (blind) console.log('vs a price-blind driver: saves $' + blind.amount + ' (' + blind.percent + '%), stops +' + blind.extra_stops);"
            ]
          }
        }
      ]
    },
