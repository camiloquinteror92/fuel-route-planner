    "description": "The trip of request 1 with a truck that does 8 miles per gallon and keeps the same 50-gallon tank (400 miles on a full tank). Only the plan changes, not the road, so there is no request to OSRM. `meta.settings_changed` names what differs from the standard truck."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const body = pm.response.json();",
       "pm.test('no request to OSRM: the road of request 1 is reused', () => {",
       "  pm.expect(body.meta.external_api_calls).to.eql(0);",
       "  pm.expect(body.meta.route_cache).to.eql('hit');",
       "});",
       "pm.test('mpg and range are the changed settings', () => {",
       "  pm.expect(body.meta.settings_changed).to.include.members(['mpg', 'max_range_miles']);",
       "});",
       "pm.test('same 50-gallon tank', () => pm.expect(body.vehicle.tank_gallons).to.eql(50));",
       "console.log('stops', body.summary.number_of_stops, '| cost $' + body.summary.total_fuel_cost,",
       "  '| gallons', body.summary.total_gallons_purchased, '| calls to OSRM', body.meta.external_api_calls,",
       "  '| time', pm.response.headers.get('X-Response-Time-ms') + ' ms');"
      ]
     }
    }
   ]
  },
  {
   "name": "4. Truck: keep 5 gallons of safety fuel (POST, safety_reserve_gal=5)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "body": {
     "mode": "raw",
     "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\",\n  \"safety_reserve_gal\": 5\n}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    },
    "url": {
     "raw": "{{baseUrl}}/api/route",
     "host": [
      "{{baseUrl}}"
     ],
     "path": [
      "api",
      "route"
     ]
    },
    "description": "The trip of request 1, but the truck must keep 5 gallons in the tank at every stop and at the finish. With no safety fuel (the default) it may reach a station on empty. No request to OSRM."
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('200 OK', () => pm.response.to.have.status(200));",
       "const body = pm.response.json();",
       "pm.test('no request to OSRM: the road of request 1 is reused', () => {",
       "  pm.expect(body.meta.external_api_calls).to.eql(0);",
       "  pm.expect(body.meta.route_cache).to.eql('hit');",
       "});",
       "pm.test('never below 5 gallons', () => {",
       "  body.fuel_stops.forEach((s) => pm.expect(s.fuel_on_arrival_gallons).to.be.at.least(5));",
       "  pm.expect(body.summary.end_fuel_gallons).to.be.at.least(5);",
       "});",
       "console.log('stops', body.summary.number_of_stops, '| cost $' + body.summary.total_fuel_cost,",
       "  '| gallons', body.summary.total_gallons_purchased, '| calls to OSRM', body.meta.external_api_calls,",
       "  '| time', pm.response.headers.get('X-Response-Time-ms') + ' ms');"
      ]
     }
    }
   ]
  },
