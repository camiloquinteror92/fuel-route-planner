          "raw": "{{baseUrl}}/api/route?start=New York, NY&finish=Los Angeles, CA&max_range_miles=300&corridor_miles=25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            },
            {
              "key": "max_range_miles",
              "value": "300"
            },
            {
              "key": "corridor_miles",
              "value": "25"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('re-planned on the cached route: no external call (after request 1)', () => {",
              "  pm.expect(body.meta.external_api_calls).to.eql(0);",
              "  pm.expect(body.meta.route_cache).to.eql('hit');",
              "});",
              "console.log('changed:', body.meta.settings_changed.join(', '), '| stops', body.summary.number_of_stops,",
              "  '| cost $' + body.summary.total_fuel_cost, '| gallons', body.summary.total_gallons_purchased);",
              "pm.test('the tank is 300 / 10 = 30 gal and never overfilled', () => {",
              "  pm.expect(body.vehicle.tank_gallons).to.eql(30);",
              "  body.fuel_stops.forEach((s) => pm.expect(s.fuel_on_arrival_gallons + s.gallons).to.be.at.most(30.01));",
              "});"
            ]
          }
        }
      ]
    },
